	"auth": {
		"type": "basic",
		"basic": [
			{
				"key": "password",
				"value": "{{authPwd}}",
				"type": "string"
			},
			{
				"key": "username",
				"value": "{{authEmail}}",
				"type": "string"
			}
		]
