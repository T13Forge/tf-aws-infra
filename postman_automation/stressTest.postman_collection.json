		{
			"name": "Update User Info",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const oldPwd = pm.collectionVariables.get('authPwd') || 'defaultPwd';",
							"pm.collectionVariables.set('oldAuthPwd', oldPwd);",
							"",
							"const newPwd = `${oldPwd}_new${Math.floor(Math.random() * 1000)}`;",
							"pm.variables.set('newPwd', newPwd);",
							"",
							"const firstNames = [\"Isaac\", \"Ethan\", \"Liam\", \"Noah\", \"Oliver\", \"Lucas\", \"Mason\", \"Elijah\", \"Logan\", \"Aiden\"];",
							"const lastNames  = [\"Tai\", \"Smith\", \"Johnson\", \"Brown\", \"Lee\", \"Davis\", \"Garcia\", \"Wilson\", \"Anderson\", \"Martinez\"];",
							"",
							"const firstName = firstNames[Math.floor(Math.random() * firstNames.length)];",
							"const lastName  = lastNames[Math.floor(Math.random() * lastNames.length)];",
							"",
							"pm.variables.set('firstName', firstName);",
							"pm.variables.set('lastName', lastName);",
							"",
							"console.log(\"Will update password (old → new):\", oldPwd, \"→\", newPwd);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Update password OK\", () => {",
							"  pm.expect(pm.response.code).to.be.within(200, 299);",
							"});",
							"",
							"// only update the pwd if success",
							"const newPwd = pm.variables.get('newPwd');",
							"if (newPwd) {",
							"  pm.collectionVariables.set('authPwd', newPwd);",
							"  pm.collectionVariables.unset('oldAuthPwd'); //",
							"  console.log(\"old pwd: \", pm.collectionVariables.get('oldAuthPwd'));",
							"  console.log(\"new pwd: \", pm.collectionVariables.get('authPwd'));",
							"  console.log(\"Promoted new password for subsequent requests:\", newPwd);",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
