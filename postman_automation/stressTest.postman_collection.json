	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"requests": {},
				"exec": [
					"// --- Run cleanup only once per run: on the first request, first iteration ---",
					"if (pm.info.iteration === 0 && pm.info.requestName === 'Check health') {",
					"  // Remove previous run’s cached variables",
					"  try {",
					"    const all = pm.collectionVariables.toObject ? pm.collectionVariables.toObject() : {};",
					"    Object.keys(all).forEach(k => {",
					"      if (k.startsWith('creds_iter_')) pm.collectionVariables.unset(k);",
					"    });",
					"  } catch (e) {",
					"    // Fallback if toObject() not supported",
					"    for (let i = 0; i < 50; i++) pm.collectionVariables.unset(`creds_iter_${i}`);",
					"  }",
					"",
					"  pm.collectionVariables.unset('authEmail');",
					"  pm.collectionVariables.unset('authPwd');",
					"",
					"  console.log('🧹 Cleared previous collection variables for a fresh run.');",
					"}",
					"",
					"// --- Get the current iteration index ---",
					"const iter = pm.info.iteration || 0;",
					"",
					"// --- Create a cache key for this iteration's credentials ---",
					"const credKey = `creds_iter_${iter}`;",
					"",
					"// --- Check if credentials for this iteration already exist ---",
					"let creds = pm.collectionVariables.get(credKey);",
					"",
					"if (!creds) {",
					"  if (iter > 0) {",
					"    const prevKey = `creds_iter_${iter - 1}`;",
					"    if (pm.collectionVariables.get(prevKey)) {",
					"      pm.collectionVariables.unset(prevKey);",
					"      console.log(`🧹 Removed previous iteration cache: ${prevKey}`);",
					"    }",
					"  }",
					"",
					"  // No credentials yet for this iteration → generate new ones",
					"  const email = `user_${iter}_${pm.variables.replaceIn('{{$timestamp}}')}_${pm.variables.replaceIn('{{$guid}}')}@example.com`;",
					"  const pwd   = `P@ss_${pm.variables.replaceIn('{{$randomInt}}')}_${pm.variables.replaceIn('{{$guid}}')}`;",
					"",
					"  // Save this iteration’s credentials as a collection-level variable",
					"  pm.collectionVariables.set(credKey, JSON.stringify({ email, pwd }));",
					"  creds = pm.collectionVariables.get(credKey);",
					"",
					"  console.log(`Generated credentials for iteration ${iter}:`, email, pwd);",
					"}",
					"",
					"// --- Retrieve the cached credentials and expose them as global variables ---",
					"const { email, pwd } = JSON.parse(creds);",
					"pm.collectionVariables.set('authEmail', email);",
					"pm.collectionVariables.set('authPwd',   pwd);",
					"",
					"// --- Set local variables so the current request can immediately use them ---",
					"pm.variables.set('authEmail', email);",
					"pm.variables.set('authPwd',   pwd);"
				]
			}
		},
